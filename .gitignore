# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/

# Distribution / packaging
build/
dist/
*.egg-info/

# Unit test / coverage / evaluation artifacts
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
evals/results/
*.sqlite3
*.sqlite3-journal
*.sqlite3-wal

# Environment & secrets (never commit real .env or credentials)
.env
.env.*
!.env.example
*credentials*.json
*service-account*.json

# Terraform local state & provider caches
terraform/.terraform/
terraform/*.tfstate
terraform/*.tfstate.*
terraform/tfplan
terraform/*.tfvars
!terraform/*.tfvars.example

# IDE / OS metadata
.DS_Store
.idea/
.vscode/
