# ==============================================================================
# Personal Travel & Budget Concierge Agent - Environment Configuration Template
# Copy to `.env` for local development. NEVER commit real secrets to Git.
# In production (Cloud Run / Vertex AI Agent Engine), secrets are injected via
# Google Cloud Secret Manager (`SecretManagerProvider`).
# ==============================================================================

# Google Cloud & Vertex AI Settings
GOOGLE_CLOUD_PROJECT=YOUR_GCP_PROJECT_ID
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=TRUE

# Strategic Model Routing Tiers
TRAVEL_FAST_MODEL=gemini-2.5-flash
TRAVEL_REASONING_MODEL=gemini-2.5-pro

# Financial Guardrails & Human-in-the-Loop (HITL) Escalation
HIGH_VALUE_PAYMENT_THRESHOLD_USD=500.0
DEFAULT_MAX_BUDGET_USD=10000.0

# Context Compaction & Persistent Session State
COMPACTION_MAX_TOKENS=4000
COMPACTION_WINDOW_TURNS=6
TRAVEL_SESSION_DB_PATH=/tmp/travel_concierge_sessions.sqlite3
FIRESTORE_DATABASE_ID=(default)
VERTEX_SEARCH_DATA_STORE_ID=travel-concierge-grounding-store

# Cloud Observability & Privacy Controls
ENABLE_CLOUD_TRACE=false
ENABLE_CLOUD_DLP=false
ENABLE_MODEL_ARMOR=false
LOG_LEVEL=INFO

# Secret Manager Identifiers (resolved at runtime via SecretManagerServiceClient;
# local fallback variable only used in offline unit/CI tests when allow_env_fallback=True)
PAYMENT_GATEWAY_SECRET_ID=travel-payment-gateway-token
TRAVEL_PAYMENT_GATEWAY_TOKEN=YOUR_LOCAL_TEST_PAYMENT_TOKEN_PLACEHOLDER
